# Telegram Bot Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Slack App Configuration
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
SLACK_APP_TOKEN=xapp-your_slack_app_token_here

# Admin Configuration (comma-separated Slack user IDs)
SLACK_ADMINS=U012A3BCD45,U067E3FGH89

# Application Configuration
PORT=3000
NODE_ENV=production
# Slack Workspace URL (required for channel links)
SLACK_WORKSPACE_URL=https://your-workspace.slack.com
# Optional: Default channel mappings (JSON format)
# Format: {"telegramChannelId": "slackChannelId", ...}
DEFAULT_CHANNEL_MAPPINGS={"@telegram_channel": "C012345ABCDE", "-1001234567890": "C098765FGHIJ"}
# Slack Bot Settings
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here
SLACK_APP_TOKEN=xapp-your-slack-app-token-here

# Security Settings
# Comma-separated list of Slack user IDs allowed to run admin commands
SLACK_ADMINS=U12345678,U87654321

# Application Settings
MAPPINGS_FILE=mappings.json
